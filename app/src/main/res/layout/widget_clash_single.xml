<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_single_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_single_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Type"
            android:src="@drawable/ic_widget_hammer" />

        <TextView
            android:id="@+id/widget_single_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NEXT UPGRADE"
            android:textColor="#FBBF24"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_single_builder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Builder #1"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Big Countdown Timer -->
    <TextView
        android:id="@+id/widget_single_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="02h 45m"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Name and Level -->
    <TextView
        android:id="@+id/widget_single_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Eagle Artillery (Lv 7)"
        android:textColor="#F8FAFC"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/widget_single_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="65"
        android:progressDrawable="@drawable/widget_progress_bar" />

    <!-- Gems or Status -->
    <TextView
        android:id="@+id/widget_single_gem_cost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="💎 185 Gems to finish"
        android:textColor="#FDE047"
        android:textSize="10sp" />
</LinearLayout>
